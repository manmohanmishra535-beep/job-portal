datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  RECRUITER
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

enum QuestionType {
  MCQ
  CODING
  THEORY
  HR
}

enum TopicCategory {
  APTITUDE
  DSA
  TECHNICAL
  HR
}

enum UserProgressStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
}

model User {
  id           String               @id @default(cuid())
  clerkId      String               @unique
  email        String               @unique
  name         String?
  role         Role                 @default(USER)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  profile      Profile?
  applications Application[]
  savedJobs    SavedJob[]
  progress     UserProgress[]
  bookmarks    BookmarkedQuestion[]
  quizAttempts QuizAttempt[]
  postedJobs   Job[]                @relation("RecruiterJobs")
  companies    Company[]            @relation("RecruiterCompanies")

  @@index([clerkId])
  @@index([email])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  phone      String?
  college    String?
  skills     String[] @default([])
  resumeUrl  String?
  location   String?
  experience String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  website     String?
  description String?
  recruiterId String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  recruiter   User     @relation("RecruiterCompanies", fields: [recruiterId], references: [id], onDelete: Cascade)
  jobs        Job[]

  @@index([recruiterId])
  @@index([name])
}

model Job {
  id              String        @id @default(cuid())
  title           String
  description     String
  location        String
  jobType         String        // FULL_TIME, PART_TIME, INTERNSHIP, CONTRACT
  salaryMin       Int?
  salaryMax       Int?
  skills          String[]      @default([])
  experienceLevel String        // Fresher, Mid, Senior
  status          String        @default("OPEN") // OPEN, CLOSED
  companyId       String
  postedById      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy        User          @relation("RecruiterJobs", fields: [postedById], references: [id], onDelete: Cascade)
  applications    Application[]
  savedByUsers    SavedJob[]

  @@index([title])
  @@index([location])
  @@index([jobType])
  @@index([status])
  @@index([companyId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  userId      String
  status      ApplicationStatus @default(APPLIED)
  resumeUrl   String?
  coverLetter String?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

model Topic {
  id        String        @id @default(cuid())
  name      String
  category  TopicCategory
  parentId  String?
  createdAt DateTime      @default(now())

  parent    Topic?        @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Topic[]       @relation("TopicHierarchy")
  questions Question[]
  notes     Note[]
  quizzes   Quiz[]

  @@index([category])
  @@index([parentId])
}

model Question {
  id           String               @id @default(cuid())
  topicId      String
  title        String
  body         String
  type         QuestionType
  difficulty   String               // Easy, Medium, Hard
  options      String[]             @default([]) // for MCQ
  answer       String               // Solution or correct option
  explanation  String?
  links        String[]             @default([]) // Practice links (LeetCode, GFG, etc.)
  createdAt    DateTime             @default(now())

  topic         Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  userProgress  UserProgress[]
  bookmarks     BookmarkedQuestion[]

  @@index([topicId])
  @@index([difficulty])
  @@index([type])
}

model Note {
  id        String   @id @default(cuid())
  topicId   String
  title     String
  content   String   // Markdown / Formula content
  createdAt DateTime @default(now())

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model CompanyGuide {
  id              String   @id @default(cuid())
  companyName     String
  slug            String   @unique
  hiringProcess   String
  rounds          Json     // List of interview / OA rounds
  tips            String[] @default([])
  commonQuestions Json     // Array of frequent interview questions
  createdAt       DateTime @default(now())

  @@index([slug])
}

model Quiz {
  id            String         @id @default(cuid())
  title         String
  topicId       String
  duration      Int            // Duration in minutes
  difficulty    String         // Easy, Medium, Hard
  createdAt     DateTime       @default(now())

  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  @@index([topicId])
}

model QuizQuestion {
  id         String   @id @default(cuid())
  quizId     String
  questionId String

  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionId])
  @@index([quizId])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  score          Int
  totalQuestions Int
  timeTaken      Int      // in seconds
  answers        Json     // User's submitted answers
  takenAt        DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model UserProgress {
  id         String             @id @default(cuid())
  userId     String
  questionId String
  status     UserProgressStatus @default(NOT_STARTED)
  updatedAt  DateTime           @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([status])
}

model BookmarkedQuestion {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  savedAt    DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}
